# 复制成 .env 后修改。.env 不进版控、不含在程式备份里。

APP_NAME=Event Face Matcher
DATABASE_PATH=data/event_faces.db
PHOTO_DIR=data/photos

# ---- 模型 ----
MODEL_ROOT=models
MODEL_NAME=buffalo_l
DET_SIZE=640

# ---- 比对（改了重开伺服器即可生效）----
# 0.40：实测 0.36 找回率 100% 但会认错人，0.40 零认错、找回率 92%
MATCH_THRESHOLD=0.40
MAX_RESULTS=100
DETECTION_SCORE_THRESHOLD=0.50
# 24：低于此像素的脸不进索引（改这个要重建索引）
MIN_FACE_SIZE=24

# ---- 效能 ----
# 每份引擎用几个 CPU 执行绪。0 = 自动（会吃满所有核，实测反而最慢）
# 16 核机器建议 4~5，大约是核心数的四分之一
ENGINE_THREADS=4
# 最多几个人可以同时算。引擎是用到才开，平常只占一份的记忆体
ENGINE_POOL_SIZE=3

# ---- 安全 ----
# 上传与删除照片的权限，务必改掉
ADMIN_API_KEY=change-me-before-production
SITE_USER=guest
# 整站密码。留空 = 整站不上锁，只有「仅区网」模式才可以这样
SITE_PASSWORD=
# QR code 里带的钥匙，来宾扫了免打字。留空 = 关掉此功能，改用帐号密码
SITE_ACCESS_TOKEN=
# 来宾扫码后免打字的有效时数
ACCESS_COOKIE_HOURS=12
# 每个 IP 每分钟搜寻上限
SEARCH_RATE_PER_MIN=20
