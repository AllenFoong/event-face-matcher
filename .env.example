# Copy to .env and edit. .env is not in version control and not in code backups.

APP_NAME=Event Face Matcher
DATABASE_PATH=data/event_faces.db
PHOTO_DIR=data/photos

# ---- Models ----
MODEL_ROOT=models
MODEL_NAME=buffalo_l
DET_SIZE=640

# ---- Matching (takes effect after a server restart) ----
# 0.40: in testing 0.36 found 100% but matched wrong people; 0.40 had zero wrong matches, 92% recall
MATCH_THRESHOLD=0.40
MAX_RESULTS=100
DETECTION_SCORE_THRESHOLD=0.50
# 24: faces smaller than this many pixels are not indexed (changing it requires a reindex)
MIN_FACE_SIZE=24

# ---- Performance ----
# CPU threads per engine. 0 = auto (uses every core, which measured slowest)
# On a 16-core machine use 4-5, roughly a quarter of the cores
ENGINE_THREADS=4
# How many searches can run at once. Engines start on demand; idle memory is one engine
ENGINE_POOL_SIZE=3

# ---- Security ----
# Permission to upload and delete photos. Change this!
ADMIN_API_KEY=change-me-before-production
SITE_USER=guest
# Site-wide password. Blank = no lock; only acceptable in LAN-only mode
SITE_PASSWORD=
# Key carried in the QR code so guests don't have to type. Blank = off, use user/password instead
SITE_ACCESS_TOKEN=
# How many hours a guest stays signed in after scanning the QR code
ACCESS_COOKIE_HOURS=12
# Searches per IP per minute
SEARCH_RATE_PER_MIN=20
